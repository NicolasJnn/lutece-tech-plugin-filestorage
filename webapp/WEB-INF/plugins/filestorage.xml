<?xml version="1.0" encoding="UTF-8"?><plug-in>
    <name>filestorage</name>
    <class>fr.paris.lutece.portal.service.plugin.PluginDefaultImplementation</class>
    <version>1.0.0-SNAPSHOT</version>
    <documentation/>
    <installation/>
    <changes/>
    <user-guide/>
    <description>filestorage.plugin.description</description>
    <provider>filestorage.plugin.provider</provider>
    <provider-url>http://lutece.paris.fr</provider-url>
    <icon-url>images/admin/skin/feature_default_icon.png</icon-url>
    <copyright>Copyright (c) 2026 Mairie de Paris</copyright>
    <core-version-dependency>
        <min-core-version>8.0.0</min-core-version>
        <max-core-version/>
    </core-version-dependency>
    <db-pool-required>1</db-pool-required>

    <admin-features>
        <admin-feature>
            <feature-id>FILESTORAGE_MANAGEMENT</feature-id>
            <feature-title>filestorage.adminFeature.filestorage_management.name</feature-title>
            <feature-description>filestorage.adminFeature.filestorage_management.description</feature-description>
            <feature-level>1</feature-level>
            <feature-url>jsp/admin/plugins/filestorage/ManageStoredFiles.jsp</feature-url>
            <feature-icon-url>images/admin/skin/feature_default_icon.png</feature-icon-url>
        </admin-feature>
    </admin-features>

    <rbac-resource-types>
        <rbac-resource-type>
            <rbac-resource-type-class>fr.paris.lutece.plugins.filestorage.service.StoredFileResourceIdService</rbac-resource-type-class>
        </rbac-resource-type>
    </rbac-resource-types>

    <insert-services>
        <insert-service>
            <insert-service-id>FILESTORAGE_INSERT_SERVICE</insert-service-id>
            <insert-service-name>filestorage.insertService.name</insert-service-name>
            <insert-service-bean-class>fr.paris.lutece.plugins.filestorage.web.FileStorageInsertServiceJspBean</insert-service-bean-class>
            <insert-service-label>filestorage.insertService.label</insert-service-label>
        </insert-service>
    </insert-services>

    <daemons>
        <daemon>
            <daemon-id>filestorageCleanup</daemon-id>
            <daemon-name>filestorage.daemon.cleanup.name</daemon-name>
            <daemon-description>filestorage.daemon.cleanup.description</daemon-description>
            <daemon-class>fr.paris.lutece.plugins.filestorage.service.FileStorageCleanupDaemon</daemon-class>
        </daemon>
    </daemons>

    <servlets>
        <servlet>
            <servlet-name>FileStorageFileServlet</servlet-name>
            <url-pattern>/servlet/plugins/filestorage/file</url-pattern>
            <servlet-class>fr.paris.lutece.plugins.filestorage.web.StoredFileServlet</servlet-class>
        </servlet>
    </servlets>
</plug-in>
